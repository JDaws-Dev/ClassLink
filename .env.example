# =============================================================================
# ClassLinker - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth (get from console.cloud.google.com)
# -----------------------------------------------------------------------------
# 1. Go to console.cloud.google.com
# 2. Create a project (or select existing)
# 3. Enable the Google Classroom API
# 4. Go to APIs & Services > Credentials
# 5. Create OAuth 2.0 Client ID (Web application)
# 6. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 7. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
# NEXTAUTH_URL: Your app's base URL (no trailing slash)
# NEXTAUTH_SECRET: Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here

# -----------------------------------------------------------------------------
# Convex (get from convex.dev)
# -----------------------------------------------------------------------------
# 1. Sign up at convex.dev
# 2. Run: npx convex init
# 3. Run: npx convex dev
# 4. Copy the deployment URL below
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url

# -----------------------------------------------------------------------------
# OpenAI (get from platform.openai.com)
# -----------------------------------------------------------------------------
# 1. Go to platform.openai.com
# 2. Create an API key
# 3. Copy the key below
# Used for the AI Tutor feature
OPENAI_API_KEY=your_openai_api_key

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Toggle features on/off during development
NEXT_PUBLIC_ENABLE_AI_TUTOR=true
NEXT_PUBLIC_ENABLE_STRIPE=false
